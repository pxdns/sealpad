		"diffEditor.insertedTextBackground": "#347D3914",
		"diffEditor.removedTextBackground": "#E5534B14",
		"diffEditor.insertedLineBackground": "#347D390A",
		"diffEditor.removedLineBackground": "#E5534B0A"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#545D68", "fontStyle": "italic" }
		},
		{
			"scope": "string",
			"settings": { "foreground": "#96D0FF" }
		},
		{
			"scope": ["constant.numeric", "constant.language"],
			"settings": { "foreground": "#6CB6FF" }
		},
		{
			"scope": "keyword",
			"settings": { "foreground": "#F47067", "fontStyle": "bold" }
		},
		{
			"scope": ["storage.type", "storage.modifier"],
			"settings": { "foreground": "#F47067" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#DCBDFB" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class"],
			"settings": { "foreground": "#8DDB8C" }
		},
		{
			"scope": "variable",
			"settings": { "foreground": "#CDD9E5" }
		},
		{
			"scope": "variable.parameter",
			"settings": { "foreground": "#E0C97A", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#8DDB8C" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#6CB6FF" }
		},
		{
			"scope": ["support.type.property-name", "meta.property-name"],
			"settings": { "foreground": "#96D0FF" }
		},
		{
			"scope": "invalid",
			"settings": { "foreground": "#FF938A", "fontStyle": "underline" }
		}
	]
}
