		"inputValidation.errorBackground": "#2D060699",
		"inputValidation.errorBorder": "#CC4444",

		"button.background": "#6644CC",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#8866EE",
		"button.secondaryBackground": "#FFFFFF0F",
		"button.secondaryForeground": "#AAAACC",
		"button.secondaryHoverBackground": "#FFFFFF18",

		"badge.background": "#6644CC",
		"badge.foreground": "#FFFFFF",

		"scrollbar.shadow": "#00000055",
