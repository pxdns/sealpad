		"tab.inactiveBackground": "#05050E66",
		"tab.inactiveForeground": "#60608866",
		"tab.border": "#FFFFFF06",
		"tab.activeBorderTop": "#8866EE",
		"tab.hoverBackground": "#FFFFFF08",

		"titleBar.activeBackground": "#08080FCC",
		"titleBar.activeForeground": "#DCDCF0",
		"titleBar.inactiveBackground": "#08080F99",
		"titleBar.inactiveForeground": "#60608866",
		"titleBar.border": "#FFFFFF08",

		"statusBar.background": "#05050FE6",
		"statusBar.foreground": "#60608899",
		"statusBar.border": "#FFFFFF06",
		"statusBar.debuggingBackground": "#6644CC",
		"statusBar.debuggingForeground": "#FFFFFF",
		"statusBarItem.hoverBackground": "#FFFFFF0F",
		"statusBarItem.remoteBackground": "#0088AA",
