		"notificationCenterHeader.background": "#0A0A14F2",

		"focusBorder": "#8866EE88",
		"widget.shadow": "#00000077",
		"selection.background": "#6644CC2E",

		"editorWidget.background": "#0A0A14F2",
		"editorWidget.border": "#FFFFFF14",
		"editorWidget.foreground": "#AAAACC",

		"quickInputList.focusBackground": "#6644CC33",
		"quickInputList.focusForeground": "#DCDCF0",
		"quickInput.background": "#0A0A14F8",
		"quickInput.foreground": "#DCDCF0",

		"editorSuggestWidget.background": "#0A0A14F2",
		"editorSuggestWidget.border": "#FFFFFF14",
		"editorSuggestWidget.foreground": "#DCDCF0",
		"editorSuggestWidget.highlightForeground": "#AA88FF",
		"editorSuggestWidget.selectedBackground": "#6644CC33",

		"breadcrumb.background": "#05050ECC",
		"breadcrumb.foreground": "#60608866",
		"breadcrumb.activeSelectionForeground": "#DCDCF0",

		"tree.indentGuidesStroke": "#FFFFFF0F",
		"editorIndentGuide.background1": "#FFFFFF08",
		"editorIndentGuide.activeBackground1": "#FFFFFF14",

		"editorGutter.background": "#05050E80",
		"editorGutter.addedBackground": "#44AA66",
		"editorGutter.deletedBackground": "#CC4444",
		"editorGutter.modifiedBackground": "#8866EE",

		"diffEditor.insertedTextBackground": "#44AA6614",
		"diffEditor.removedTextBackground": "#CC444414",
		"diffEditor.insertedLineBackground": "#44AA660A",
		"diffEditor.removedLineBackground": "#CC44440A"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#404060", "fontStyle": "italic" }
		},
		{
			"scope": "string",
			"settings": { "foreground": "#88DDCC" }
		},
		{
			"scope": ["constant.numeric", "constant.language"],
			"settings": { "foreground": "#AACCFF" }
		},
		{
			"scope": "keyword",
			"settings": { "foreground": "#CC88FF", "fontStyle": "bold" }
		},
		{
			"scope": ["storage.type", "storage.modifier"],
			"settings": { "foreground": "#CC88FF" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#66CCFF" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class"],
			"settings": { "foreground": "#88DDCC" }
		},
		{
			"scope": "variable",
			"settings": { "foreground": "#DCDCF0" }
		},
		{
			"scope": "variable.parameter",
			"settings": { "foreground": "#DDBBFF", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#CC88FF" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#66CCFF" }
		},
		{
			"scope": ["support.type.property-name", "meta.property-name"],
			"settings": { "foreground": "#88DDCC" }
		},
		{
			"scope": "invalid",
			"settings": { "foreground": "#FF7777", "fontStyle": "underline" }
		}
	]
}
