		"menu.separatorBackground": "#FFFFFF0F",
		"menubar.selectionBackground": "#FFFFFF0A",
		"menubar.selectionForeground": "#DCDCF0",

		"notifications.background": "#12121EF2",
		"notifications.foreground": "#DCDCF0",
