		"editorSuggestWidget.selectedBackground": "#5E17EB33",

		"breadcrumb.background": "#0A0A1499",
		"breadcrumb.foreground": "#9090B899",
		"breadcrumb.activeSelectionForeground": "#E8E8F0",

		"tree.indentGuidesStroke": "#FFFFFF1A",
		"editorIndentGuide.background1": "#FFFFFF0A",
		"editorIndentGuide.activeBackground1": "#FFFFFF1A",

		"editorGutter.background": "#0A0A1480",
		"editorGutter.addedBackground": "#00B4D8",
		"editorGutter.deletedBackground": "#FF4444",
		"editorGutter.modifiedBackground": "#5E17EB",

		"diffEditor.insertedTextBackground": "#00B4D814",
		"diffEditor.removedTextBackground": "#FF444414",
		"diffEditor.insertedLineBackground": "#00B4D80A",
		"diffEditor.removedLineBackground": "#FF44440A"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#5060A0", "fontStyle": "italic" }
		},
		{
			"scope": "string",
			"settings": { "foreground": "#7FD4C1" }
		},
		{
			"scope": ["constant.numeric", "constant.language"],
			"settings": { "foreground": "#B49FFF" }
		},
		{
			"scope": "keyword",
			"settings": { "foreground": "#A090FF", "fontStyle": "bold" }
		},
		{
			"scope": ["storage.type", "storage.modifier"],
			"settings": { "foreground": "#A090FF" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#60C0F0" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class"],
			"settings": { "foreground": "#7FD4C1" }
		},
		{
			"scope": "variable",
			"settings": { "foreground": "#D0D0E8" }
		},
		{
			"scope": "variable.parameter",
			"settings": { "foreground": "#C8B8FF", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#A090FF" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#60C0F0" }
		},
		{
			"scope": ["support.type.property-name", "meta.property-name"],
			"settings": { "foreground": "#7FD4C1" }
		},
		{
			"scope": "invalid",
			"settings": { "foreground": "#FF6666", "fontStyle": "underline" }
		}
	]
}
